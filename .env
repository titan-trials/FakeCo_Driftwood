# Production stack settings (read automatically by docker compose).
FRONTEND_PORT=8080
API_PORT=8000
PG_PORT=5432
REDIS_PORT=6379
PROM_PORT=9090
LOG_DIR=./logs

SEED_ORDERS=2000000
SEED_CUSTOMERS=250000

# Customer visits per second (~4.5 API requests each). Raise it if an incident
# looks too mild on fast hardware; see README "Calibrating".
LOADGEN_RATE=30
LOADGEN_REPLICAS=1
