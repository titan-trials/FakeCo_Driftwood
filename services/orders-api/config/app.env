# orders-api runtime config. Deployed with the service: change it with a commit,
# then run ops/deploy.sh.
# Fail fast: a request stuck behind a slow query is worse than a quick error.
# p99 of normal queries is well under 100ms.
DB_TIMEOUT_MS=100
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT_MS=2000
PRODUCTS_CACHE_TTL_S=60
BESTSELLERS_CACHE_TTL_S=30
